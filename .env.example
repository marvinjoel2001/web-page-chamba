# Public backend URL. Required when building for production.
# Accepts either the API base (ending in /api) or the backend origin.
# Producción (Railway): https://web-production-f0db6d.up.railway.app/api
# Local: http://localhost:3020/api (o el puerto configurado en backend-chamba/.env.local)
NEXT_PUBLIC_API_URL=https://web-production-f0db6d.up.railway.app/api

# Dominio público del sitio. Sin esto, `src/lib/seo.ts` cae a la URL de Vercel
# o a https://chamba.app, y los canonical, hreflang y el sitemap apuntarían al
# dominio equivocado.
# Usar el dominio con `www` (el apex chambatrabajo.com redirige 308 a www),
# sin barra final y sin el idioma: el código añade /es, /en o /pt por su cuenta.
NEXT_PUBLIC_SITE_URL=https://www.chambatrabajo.com

# Token de verificación de Google Search Console (solo el valor de content,
# no la etiqueta <meta> completa). Si se deja vacío no se emite la etiqueta.
GOOGLE_SITE_VERIFICATION=

# Token de verificación de Bing Webmaster Tools.
BING_SITE_VERIFICATION=
